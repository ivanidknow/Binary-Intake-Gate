# =============================================================================
# Binary Intake Gate — Environment Variables
# =============================================================================
# Скопируйте этот файл в .env и заполните значения.
# Файл .env добавлен в .gitignore и не попадёт в репозиторий.
# =============================================================================

# -----------------------------------------------------------------------------
# VirusTotal API
# -----------------------------------------------------------------------------
# API ключ VirusTotal (обязателен для VT lookup/upload)
# Получить: https://www.virustotal.com/gui/my-apikey
VT_API_KEY="3a9e73d905e466515459b93136c4fa5effb9c0db4cf10c39b9f990a68b3da5e6"

# Таймаут запросов к VT API (секунды)
VT_TIMEOUT_SEC=20

# Минимальный интервал между запросами (секунды, для rate limiting)
VT_MIN_INTERVAL=6.0

# Лимит запросов в минуту (Public API = 4, Premium = больше)
VT_REQUESTS_PER_MINUTE=3

# Retry при 429 (rate limit exceeded)
VT_429_MAX_RETRIES=5
VT_429_BASE_DELAY=2.0
VT_429_MAX_DELAY=120.0

# UI Fallback (Playwright scraping) — по умолчанию отключён
VT_ENABLE_UI_FALLBACK=0
VT_UI_HEADLESS=1
VT_UI_BROWSER=chromium

# Режим опроса после загрузки файла
VT_POLL_SEC=6
VT_POLL_TIMEOUT=180

# -----------------------------------------------------------------------------
# Capa (technique analysis)
# -----------------------------------------------------------------------------
# Путь к директории с правилами capa (clone capa-rules repo)
CAPA_RULES_DIR=

# Включить глубокий анализ capa (по умолчанию только YARA+DIE)
ENABLE_DEEP_CAPA=0

# Таймаут и лимиты capa
CAPA_TIMEOUT_SEC=45
CAPA_MAX_MB=0

# Scope tags для ограничения правил (ускоряет анализ)
CAPA_SCOPE_TAGS=anti-analysis,impact

# Путь к исполняемому файлу capa (если не в PATH)
CAPA_EXE=

# -----------------------------------------------------------------------------
# YARA
# -----------------------------------------------------------------------------
# Путь к директории с YARA правилами (*.yar, *.yara)
YARA_RULES_DIR=

# Таймаут и лимиты
YARA_TIMEOUT_SEC=7
YARA_MAX_MB=0
YARA_MAX_HITS=80
YARA_FAST=1
YARA_USE_BUILTIN=1

# Директория для кэша скомпилированных правил (.yarac)
YARA_CACHE_DIR=

# -----------------------------------------------------------------------------
# CVE Scanning (Syft + Grype via Docker)
# -----------------------------------------------------------------------------
# Экосистема для резолва версий (Debian, Ubuntu, Alpine, RedHat)
CVE_ECOSYSTEM=

# Путь к inventory файлу
CVE_INVENTORY=

# Путь к libmap файлу
CVE_LIBMAP=

# Режим резолва (auto, strict, none)
CVE_RESOLVE=auto

# -----------------------------------------------------------------------------
# Docker Container Management
# -----------------------------------------------------------------------------
# Отключить автоматический pull недостающих Docker образов при запуске scan
# При включении (=1) scan не будет автоматически загружать Syft/Grype/DIE образы
# Используйте 'bin-gate cve-check --pull' для ручной загрузки
BIN_GATE_NO_AUTO_PULL=0

# DIE (Detect It Easy): имя/путь к бинарнику внутри контейнера (по умолчанию diec)
# Если образ использует ENTRYPOINT diec, задайте пустое значение, чтобы передавать только аргументы
# DIE_EXECUTABLE=diec

# -----------------------------------------------------------------------------
# Archives
# -----------------------------------------------------------------------------
# Глубина распаковки вложенных архивов
ARCH_DEPTH=2

# Максимум файлов из одного архива
ARCH_MAX_CHILDREN=5000

# Максимальный размер архива (MB)
ARCH_MAX_MB=512

# Таймаут на распаковку (секунды)
ARCH_TIMEOUT=90

# -----------------------------------------------------------------------------
# Reputation scanning
# -----------------------------------------------------------------------------
# Путь к YAML с правилами репутации
REPUTATION_RULES=

# Лимиты
REPUTATION_MAX_BYTES=20971520
REPUTATION_MIN_STR=4

# -----------------------------------------------------------------------------
# Workers & Performance
# -----------------------------------------------------------------------------
# Количество параллельных воркеров
BIN_GATE_WORKERS=4

# TTL кэша evidence (секунды, default 7 дней)
BIN_GATE_EVIDENCE_TTL_SEC=604800

# Профиль политики по умолчанию (dev, staging, prod)
BIN_GATE_PROFILE=dev

# Поведение при deny/warn (none, warn, deny)
BIN_GATE_FAIL_ON=none

# -----------------------------------------------------------------------------
# DLL Scanning (PE deep scan)
# -----------------------------------------------------------------------------
DLL_SCAN_DEPTH=2
DLL_SCAN_MAX=200

# -----------------------------------------------------------------------------
# MSI Processing
# -----------------------------------------------------------------------------
BIN_GATE_MSI_DEBUG=0
BIN_GATE_MSI_TIMEOUT=25
BIN_GATE_ENABLE_MSIEXEC=0

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
# Временная директория (рекомендуется tmpfs/RAM disk для скорости)
# Linux: /dev/shm или создайте: mount -t tmpfs -o size=2G tmpfs /mnt/ramdisk
BIN_GATE_TMPDIR=

# Порог для in-memory обработки (MB). Файлы меньше этого размера
# обрабатываются в памяти без записи на диск.
BIN_GATE_MEMORY_THRESHOLD_MB=50

# -----------------------------------------------------------------------------
# Advanced Malware Detection (v0.0.8)
# -----------------------------------------------------------------------------

# --- Emulation (Speakeasy) ---
# Включить эмуляцию PE файлов через Speakeasy (CPU-intensive, по умолчанию выключена)
# Требует: pip install binary-intake-gate[emulation]
BIN_GATE_ENABLE_EMULATION=1

# Таймаут эмуляции в секундах (жёстко применяется для предотвращения зависания воркеров)
BIN_GATE_EMULATION_TIMEOUT=60

# Максимальное количество инструкций для эмуляции
BIN_GATE_EMULATION_MAX_INSTR=10000000

# Максимальный размер файла для эмуляции (MB)
BIN_GATE_EMULATION_MAX_MB=50

# --- Threat Intelligence ---
# Включить Threat Intelligence (URLHaus, Abuse.ch feeds, DGA detection)
# Требует: pip install binary-intake-gate[threatintel]
BIN_GATE_ENABLE_TI=1

# Таймаут TI запросов (секунды)
BIN_GATE_TI_TIMEOUT=30

# TTL кэша TI feeds (часы)
BIN_GATE_TI_CACHE_TTL=24

# Отключить DGA detection (по умолчанию включена если TI включена)
BIN_GATE_DISABLE_DGA=0

# Кастомные URL для TI feeds (опционально, по умолчанию используются официальные)
# BIN_GATE_TI_URLHAUS_FEED=https://urlhaus.abuse.ch/downloads/csv_recent/
# BIN_GATE_TI_ABUSECH_FEED=https://feodotracker.abuse.ch/downloads/ipblocklist_aggressive.csv

# --- Deep Script & Office Analysis ---
# Включить глубокий анализ скриптов и документов (oletools VBA, LNK parsing)
# Требует: pip install binary-intake-gate[oletools]
BIN_GATE_ENABLE_DEEP_SCRIPT=1

# --- Visual Analysis (PE icons) ---
# Включить анализ иконок PE файлов и детекцию masquerading
# Требует: pip install binary-intake-gate[visual]
BIN_GATE_ENABLE_VISUAL=1

# -----------------------------------------------------------------------------
# Debug
# -----------------------------------------------------------------------------
# Временная директория (legacy, используйте BIN_GATE_TMPDIR)
BIN_GATE_TMP=

# Путь к Bandit (Python SAST)
BIN_GATE_BANDIT=

# Debug режимы
# Директория для сохранения отладочных данных (логи анализаторов, дампы и т.д.)
BIN_GATE_DEBUG_DIR=
